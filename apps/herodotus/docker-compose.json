{
    "services": [
        {
            "name": "herodotus",
            "image": "palestamp/herodotus:0.0.3",
            "internalPort": 80,
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/data",
                    "containerPath": "/var/opt/herodotus",
                    "readOnly": false,
                    "shared": false,
                    "private": false
                }
            ],
            "isMain": true,
            "environment": {}
        }
    ]
}