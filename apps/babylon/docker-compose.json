{
    "services": [
        {
            "name": "babylon",
            "image": "palestamp/babylon:0.0.29",
            "internalPort": 80,
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/data",
                    "containerPath": "/var/opt/babylon",
                    "readOnly": false,
                    "shared": false,
                    "private": false
                }
            ],
            "isMain": true,
            "environment": {
                "OPENAI_API_KEY": "${OPENAI_API_KEY}"
            }
        }
    ]
}